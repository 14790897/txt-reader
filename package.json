{
  "name": "moyu-reader",
  "displayName": "摸鱼阅读器 (Moyu Reader)",
  "description": "把 txt 伪装成代码样式：语法高亮、代码模板伪装、老板键一键还原。上班摸鱼神器。",
  "version": "0.5.0",
  "publisher": "take-a-rest-dev",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/14790897/moyu-reader"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "keywords": [
    "txt",
    "novel",
    "moyu",
    "摸鱼",
    "小说"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:moyu-txt",
    "onCommand:moyu.disguise",
    "onCommand:moyu.restore",
    "onCommand:moyu.panic",
    "onCommand:moyu.toggleStyle",
    "onCommand:moyu.applyTheme",
    "onCommand:moyu.applyReadingSettings",
    "onCommand:moyu.pickDialogueStyle",
    "onCommand:moyu.cycleDialogueColors",
    "onCommand:moyu.analyzeSpeakers"
  ],
  "contributes": {
    "languages": [
      {
        "id": "moyu-txt",
        "aliases": [
          "摸鱼文本",
          "Moyu Text"
        ],
        "extensions": [
          ".txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "moyu-txt",
        "scopeName": "text.moyu",
        "path": "./syntaxes/moyu.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Moyu Dark (摸鱼暗色)",
        "uiTheme": "vs-dark",
        "path": "./themes/moyu-dark.json"
      }
    ],
    "commands": [
      {
        "command": "moyu.disguise",
        "title": "伪装成代码",
        "category": "摸鱼"
      },
      {
        "command": "moyu.restore",
        "title": "还原原文",
        "category": "摸鱼"
      },
      {
        "command": "moyu.panic",
        "title": "紧急还原（老板键）",
        "category": "摸鱼",
        "icon": "$(eye-closed)"
      },
      {
        "command": "moyu.toggleStyle",
        "title": "切换 代码样式/纯文本",
        "category": "摸鱼"
      },
      {
        "command": "moyu.applyTheme",
        "title": "启用摸鱼主题",
        "category": "摸鱼"
      },
      {
        "command": "moyu.applyReadingSettings",
        "title": "应用阅读设置",
        "category": "摸鱼"
      },
      {
        "command": "moyu.pickDialogueStyle",
        "title": "切换对话引号样式 (Dialogue Style)",
        "category": "摸鱼"
      },
      {
        "command": "moyu.cycleDialogueColors",
        "title": "循环配色对话 (Cycle Colors)",
        "category": "摸鱼"
      },
      {
        "command": "moyu.analyzeSpeakers",
        "title": "AI 识别说话人 (Analyze Speakers)",
        "category": "摸鱼"
      }
    ],
    "keybindings": [
      {
        "command": "moyu.disguise",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus && resourceExtname == .txt"
      },
      {
        "command": "moyu.panic",
        "key": "ctrl+alt+x",
        "when": "editorTextFocus"
      },
      {
        "command": "moyu.pickDialogueStyle",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus && resourceExtname == .txt"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "moyu.disguise",
          "when": "resourceExtname == .txt && !moyu.isDisguised",
          "group": "moyu@1"
        },
        {
          "command": "moyu.restore",
          "when": "moyu.isDisguised",
          "group": "moyu@2"
        },
        {
          "command": "moyu.panic",
          "when": "moyu.isDisguised",
          "group": "moyu@3"
        },
        {
          "command": "moyu.toggleStyle",
          "when": "resourceExtname == .txt",
          "group": "moyu@3"
        },
        {
          "command": "moyu.pickDialogueStyle",
          "group": "moyu@4",
          "when": "resourceExtname == .txt"
        }
      ],
      "editor/title": [
        {
          "command": "moyu.panic",
          "when": "moyu.isDisguised",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "摸鱼阅读器",
      "properties": {
        "moyu.template": {
          "type": "string",
          "enum": [
            "python",
            "cpp",
            "js"
          ],
          "enumDescriptions": [
            "Python 脚本模板",
            "C++ 工程模板",
            "Node.js 脚本模板"
          ],
          "default": "python",
          "description": "「伪装成代码」时使用的代码模板"
        },
        "moyu.reading.enabled": {
          "type": "boolean",
          "default": true,
          "description": "自动为「摸鱼文本」应用舒适的阅读排版（字号/行距），只影响 .txt 文件，老板键还原后会变回普通密集排版"
        },
        "moyu.reading.fontSize": {
          "type": "number",
          "default": 20,
          "minimum": 12,
          "maximum": 40,
          "description": "摸鱼文本的阅读字号（默认 20；普通代码编辑器约 13）"
        },
        "moyu.reading.lineHeight": {
          "type": "number",
          "default": 2.2,
          "minimum": 1,
          "maximum": 4,
          "description": "摸鱼文本的行距倍率（默认 2.2；普通代码约 1.4 的密集行距）"
        },
        "moyu.reading.fontFamily": {
          "type": "string",
          "default": "",
          "description": "摸鱼文本的字体（留空则跟随全局字体，可填如 'Microsoft YaHei' 或带 fallback 的字体列表）"
        },
        "moyu.highlight.dialogueStyle": {
          "type": "string",
          "enum": [
            "string",
            "bold",
            "plain"
          ],
          "enumDescriptions": [
            "字符串色（默认，橙红色，与其他语言字符串一致）",
            "加粗（与正文同色，不刺眼）",
            "纯文本（不特殊处理）"
          ],
          "default": "string",
          "description": "中文对话引号（“”「」）的显示样式"
        },
        "moyu.dialogue.speakerColors": {
          "type": "string",
          "enum": [
            "off",
            "cycle",
            "ai"
          ],
          "enumDescriptions": [
            "关闭（仅基础对话样式）",
            "循环配色（每段对话轮换不同颜色，无需 AI）",
            "AI 识别说话人（按人固定配色，需先运行「AI 识别说话人」命令，结果自动缓存）"
          ],
          "default": "off",
          "description": "对话按说话人配色模式"
        },
        "moyu.dialogue.ai.model": {
          "type": "string",
          "default": "claude-opus-5",
          "description": "AI 识别说话人使用的 Claude 模型（可换 claude-haiku-4-5 降低成本）"
        },
        "moyu.dialogue.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API Key（留空则读取环境变量 ANTHROPIC_API_KEY）"
        },
        "moyu.dialogue.ai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "API 地址（留空使用官方地址；使用代理/中继时填写）"
        }
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0"
  }
}
