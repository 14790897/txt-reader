{
  "name": "txt-beautifier",
  "displayName": "TXT 美化阅读器 (TXT Beautify Reader)",
  "description": "txt 阅读器：代码风格语法高亮、舒适阅读排版、按说话人对话配色，支持 AI 识别说话人与一键还原原文。",
  "version": "0.6.5",
  "publisher": "take-a-rest-dev",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/14790897/txt-reader"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "keywords": [
    "txt",
    "novel",
    "reader",
    "beautifier",
    "小说"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:txt-reader",
    "onCommand:txtreader.disguise",
    "onCommand:txtreader.restore",
    "onCommand:txtreader.panic",
    "onCommand:txtreader.toggleStyle",
    "onCommand:txtreader.applyTheme",
    "onCommand:txtreader.applyReadingSettings",
    "onCommand:txtreader.pickDialogueStyle",
    "onCommand:txtreader.cycleDialogueColors",
    "onCommand:txtreader.analyzeSpeakers"
  ],
  "contributes": {
    "languages": [
      {
        "id": "txt-reader",
        "aliases": [
          "TXT 阅读",
          "TXT Reader"
        ],
        "extensions": [
          ".txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "txt-reader",
        "scopeName": "source.txtreader",
        "path": "./syntaxes/txtreader.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "TXT Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/txt-dark.json"
      }
    ],
    "commands": [
      {
        "command": "txtreader.disguise",
        "title": "伪装成代码",
        "category": "TXT 阅读器"
      },
      {
        "command": "txtreader.restore",
        "title": "还原原文",
        "category": "TXT 阅读器"
      },
      {
        "command": "txtreader.panic",
        "title": "紧急还原（老板键）",
        "category": "TXT 阅读器",
        "icon": "$(eye-closed)"
      },
      {
        "command": "txtreader.toggleStyle",
        "title": "切换 代码样式/纯文本",
        "category": "TXT 阅读器"
      },
      {
        "command": "txtreader.applyTheme",
        "title": "切换 TXT Dark 主题",
        "category": "TXT 阅读器"
      },
      {
        "command": "txtreader.applyReadingSettings",
        "title": "应用阅读设置",
        "category": "TXT 阅读器"
      },
      {
        "command": "txtreader.pickDialogueStyle",
        "title": "切换对话引号样式 (Dialogue Style)",
        "category": "TXT 阅读器"
      },
      {
        "command": "txtreader.cycleDialogueColors",
        "title": "循环配色对话 (Cycle Colors)",
        "category": "TXT 阅读器"
      },
      {
        "command": "txtreader.analyzeSpeakers",
        "title": "AI 识别说话人 (Analyze Speakers)",
        "category": "TXT 阅读器"
      }
    ],
    "keybindings": [
      {
        "command": "txtreader.disguise",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus && resourceExtname == .txt"
      },
      {
        "command": "txtreader.panic",
        "key": "ctrl+alt+x",
        "when": "editorTextFocus"
      },
      {
        "command": "txtreader.pickDialogueStyle",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus && resourceExtname == .txt"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "txtreader.disguise",
          "when": "resourceExtname == .txt && !txtreader.isDisguised",
          "group": "txtreader@1"
        },
        {
          "command": "txtreader.restore",
          "when": "txtreader.isDisguised",
          "group": "txtreader@2"
        },
        {
          "command": "txtreader.panic",
          "when": "txtreader.isDisguised",
          "group": "txtreader@3"
        },
        {
          "command": "txtreader.toggleStyle",
          "when": "resourceExtname == .txt",
          "group": "txtreader@3"
        },
        {
          "command": "txtreader.pickDialogueStyle",
          "group": "txtreader@4",
          "when": "resourceExtname == .txt"
        },
        {
          "command": "txtreader.cycleDialogueColors",
          "when": "resourceExtname == .txt",
          "group": "txtreader@5"
        },
        {
          "command": "txtreader.analyzeSpeakers",
          "when": "resourceExtname == .txt",
          "group": "txtreader@6"
        }
      ],
      "editor/title": [
        {
          "command": "txtreader.panic",
          "when": "txtreader.isDisguised",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "TXT 阅读器",
      "properties": {
        "txtreader.template": {
          "type": "string",
          "enum": [
            "python",
            "cpp",
            "js"
          ],
          "enumDescriptions": [
            "Python 脚本模板",
            "C++ 工程模板",
            "Node.js 脚本模板"
          ],
          "default": "python",
          "description": "「伪装成代码」时使用的代码模板"
        },
        "txtreader.reading.enabled": {
          "type": "boolean",
          "default": true,
          "description": "自动为「TXT 阅读」应用舒适的阅读排版（字号/行距），只影响 .txt 文件，老板键还原后会变回普通密集排版"
        },
        "txtreader.reading.fontSize": {
          "type": "number",
          "default": 20,
          "minimum": 12,
          "maximum": 40,
          "description": "TXT 阅读的阅读字号（默认 20；普通代码编辑器约 13）"
        },
        "txtreader.reading.lineHeight": {
          "type": "number",
          "default": 2.2,
          "minimum": 1,
          "maximum": 4,
          "description": "TXT 阅读的行距倍率（默认 2.2；普通代码约 1.4 的密集行距）"
        },
        "txtreader.reading.fontFamily": {
          "type": "string",
          "default": "",
          "description": "TXT 阅读的字体（留空则跟随全局字体，可填如 'Microsoft YaHei' 或带 fallback 的字体列表）"
        },
        "txtreader.highlight.dialogueStyle": {
          "type": "string",
          "enum": [
            "string",
            "bold",
            "plain"
          ],
          "enumDescriptions": [
            "字符串色（默认，橙红色，与其他语言字符串一致）",
            "加粗（与正文同色，不刺眼）",
            "纯文本（不特殊处理）"
          ],
          "default": "string",
          "description": "中文对话引号（“”「」）的显示样式"
        },
        "txtreader.dialogue.speakerColors": {
          "type": "string",
          "enum": [
            "off",
            "cycle",
            "ai"
          ],
          "enumDescriptions": [
            "关闭（仅基础对话样式）",
            "循环配色（每段对话轮换不同颜色，无需 AI）",
            "AI 识别说话人（按人固定配色，需先运行「AI 识别说话人」命令，结果自动缓存）"
          ],
          "default": "off",
          "description": "对话按说话人配色模式"
        },
        "txtreader.dialogue.ai.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "deepseek"
          ],
          "enumDescriptions": [
            "Anthropic Claude（默认，官方 SDK）",
            "OpenAI 兼容接口（/v1/chat/completions，适用于 OpenAI、Kimi、通义、各类中转代理）",
            "DeepSeek 官方接口（预设 baseUrl 与模型，只需填 API Key）"
          ],
          "default": "anthropic",
          "description": "AI 识别说话人的接口格式"
        },
        "txtreader.dialogue.ai.model": {
          "type": "string",
          "default": "",
          "description": "AI 识别说话人使用的模型（留空按接口自动选择：Anthropic→claude-opus-5，OpenAI→gpt-4o-mini，DeepSeek→deepseek-flash）"
        },
        "txtreader.dialogue.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API Key（留空则读取环境变量 ANTHROPIC_API_KEY）"
        },
        "txtreader.dialogue.ai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "API 地址（留空使用官方地址；使用代理/中继时填写）"
        }
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0"
  }
}
